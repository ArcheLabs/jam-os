{
  "name": "jam-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "pretest": "npm run toolchain:client:build && node scripts/check-test-boundary.mjs",
    "test:watch": "vitest",
    "prebuild": "npm run toolchain:client:build",
    "preview": "vite preview",
    "smoke:live": "node scripts/smoke-live.mjs",
    "stage1:guard": "node scripts/stage1-guards.mjs",
    "ci:lint": "scripts/check-action-manifest.sh",
    "doom:native:check": "scripts/check-doom-native-prerequisites.sh",
    "toolchain:bootstrap": "scripts/bootstrap-toolchains.sh",
    "jns:abi": "scripts/generate-jns-abi.sh",
    "jns:abi:check": "scripts/check-jns-abi.sh",
    "toolchain:client:build": "npm --prefix .toolchain/JamScript/packages/client run build"
  },
  "dependencies": {
    "@jamscript/minijam-client": "file:.toolchain/JamScript/packages/client",
    "@monaco-editor/react": "^4.7.0",
    "@polkadot/extension-dapp": "^0.62.6",
    "@polkadot/util": "^14.0.1",
    "@polkadot/util-crypto": "^14.0.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.3.0",
    "dompurify": "^3.2.6",
    "lucide-react": "^1.31.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
