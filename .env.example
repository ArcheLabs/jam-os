# Local development defaults to the isolated mock runtime.
VITE_JAM_MODE=mock

# Live mode requires all three RPC endpoints, a genesis hash, and the promoted
# Computer artifact hash. Do not put signing keys or tokens in this file.
# VITE_JAM_MODE=live
# VITE_MINIJAM_NODE_RPC_URL=https://node.example.invalid
# VITE_MINIJAM_WORK_RPC_URL=https://work.example.invalid
# VITE_MINIJAM_DEPLOYMENT_RPC_URL=https://deploy.example.invalid
# VITE_MINIJAM_GENESIS_HASH=0x<genesis-hash>
# VITE_COMPUTER_SERVICE_CODE_HASH=0x<code-hash>

# Production GitHub Pages values are supplied as public GitHub Repository
# Variables and validated before the frontend build.
